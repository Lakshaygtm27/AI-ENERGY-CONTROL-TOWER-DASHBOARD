# ====================================================================
# AI ENERGY CONTROL TOWER - ENVIRONMENT VARIABLES
# ====================================================================

# -------- APPLICATION SETTINGS --------
ENVIRONMENT=development
DEBUG=True
API_LOG_LEVEL=INFO
LOG_LEVEL=INFO
LOG_FORMAT=json

# -------- API SETTINGS --------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# -------- POSTGRESQL DATABASE --------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=energy_tower
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_POOL_RECYCLE=3600

# -------- KAFKA SETTINGS --------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=energy-tower-consumer

# -------- OPEN-METEO API (Free Weather) --------
OPENMETEO_API_URL=https://api.open-meteo.com/v1
OPENMETEO_TIMEOUT=30
OPENMETEO_RETRY_COUNT=3

# -------- ENTSO-E API (Requires API Key) --------
# Get key from: https://transparency.entsoe.eu/
# Leave blank if not available (synthetic data only)
ENTSOE_API_KEY=
ENTSOE_API_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_TIMEOUT=30

# -------- ANALYTICS SETTINGS --------
BASELINE_WINDOW_DAYS=30
ANOMALY_Z_SCORE_THRESHOLD=3.0
FORECAST_HORIZONS=24
SPARK_MASTER=local[*]

# -------- LOGGING SETTINGS --------
LOG_DIR=./logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=10

# -------- SYNTHETIC DATA SETTINGS --------
SYNTHETIC_DATA_INTERVAL_SECONDS=5
SYNTHETIC_DATA_BATCH_SIZE=1

# ====================================================================
# NOTES:
# - Change ENVIRONMENT to 'production' for prod deployments
# - Add ENTSOE_API_KEY when available
# - PostgreSQL must be running before starting the app
# - Kafka broker must be accessible
# ====================================================================
